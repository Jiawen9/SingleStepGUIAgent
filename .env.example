# Copy this file to .env and fill in local values.
# .env is ignored by Git and must not be committed.
MODEL_URL=https://example.com/v1
MODEL_NAME=your-model
MODEL_API_KEY=
ADB_PATH=C:\path\to\platform-tools\adb.exe
DEVICE_ID=
SCRCPY_PATH=C:\path\to\scrcpy\scrcpy.exe
IQIYI_ACTION_MODE=medium

# PaddleOCR engine: cloud or local. Empty records a recoverable error and
# continues with VLA when OCR is reached.
OCR_PROVIDER=
OCR_CLOUD_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
OCR_CLOUD_TOKEN=
# Local endpoint accepts multipart field `file` and returns a top-level
# `results` list containing text, rec_score, and bounding_box.
OCR_LOCAL_URL=http://127.0.0.1:8080/predict
OCR_MIN_SCORE=0.5
OCR_DIAGNOSTIC_TOP_N=3
OCR_TIMEOUT_SECONDS=120
OCR_POLL_INTERVAL_SECONDS=5
OCR_CONNECTION_RETRIES=3
OCR_RETRY_BACKOFF_SECONDS=2
